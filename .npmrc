# Expo's packages declare peers loosely; auto-installing them fights the
# versions pinned in expo/bundledNativeModules.json.
auto-install-peers=false
strict-peer-dependencies=false

# Left on pnpm's default isolated linker deliberately.
#
# node-linker=hoisted looks like the fix for React Native's flat-node_modules
# assumptions, but in this layout it hoists @expo/metro-config to the repo root
# while `expo` stays in apps/mobile, and the hoisted copy then cannot resolve
# `expo/package.json`. Isolated works as long as anything the bundler reaches for
# is a declared dependency of apps/mobile — including packages we never import
# ourselves (@expo/metro-runtime, expo-font). If a build fails with
# "Unable to resolve module X", add X to apps/mobile/package.json at the version
# in expo/bundledNativeModules.json rather than switching linkers.
