# Copy to .env and fill in. Never commit .env.
#
# For the app you need exactly two values. Everything else here is optional or
# server-side only. Run `pnpm doctor` to check them — it prints no secrets.

# --- Supabase (client-safe: these ship inside the app bundle) ---
# Dashboard -> Project Settings -> Data API -> Project URL
EXPO_PUBLIC_SUPABASE_URL=
# Dashboard -> Project Settings -> API keys -> anon / public
# NOT the service_role key. RLS is what protects your data, not this key.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Google sign-in ---
# Nothing goes here. The Google client ID and secret are pasted into the
# Supabase dashboard (Authentication -> Providers -> Google); the app never
# sees them. See docs/04-setup.md.

# --- Local Postgres for migration + RLS testing (scripts/db.sh) ---
# Not a Supabase connection. Leave as-is for development.
PGPORT=54329
DATABASE_URL=postgresql://postgres@127.0.0.1:54329/jobdrop

# --- Server-side only. NEVER prefix these with EXPO_PUBLIC_. ---
# The ingest worker needs a real DATABASE_URL (Supabase -> Settings -> Database
# -> Connection string -> session pooler). It contains your database password.
# SUPABASE_SERVICE_ROLE_KEY is not used by anything yet; if you add it, keep it
# on the worker host only.
