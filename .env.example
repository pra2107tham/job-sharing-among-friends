# Copy to .env and fill in. Never commit .env.

# --- Supabase (client-safe: these ship inside the app bundle) ---
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- OAuth client IDs (client-safe) ---
# Google Cloud Console > Credentials. You need three separate OAuth clients.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# --- Local Postgres (scripts/db.sh) ---
# Only used for local migration + RLS testing. Not a Supabase connection.
PGPORT=54329
DATABASE_URL=postgresql://postgres@127.0.0.1:54329/jobdrop

# --- Server-side only. NEVER prefix these with EXPO_PUBLIC_. ---
# SUPABASE_SERVICE_ROLE_KEY=
